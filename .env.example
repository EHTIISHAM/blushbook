# Copy to .env.local and fill in. Never commit .env.local.
#
# NOTE: every NEXT_PUBLIC_* value is compiled into the browser bundle when the
# app is built, not read at container start. In production they must be passed
# as Docker build arguments as well as runtime env vars, and changing one means
# a rebuild. See DEPLOY.md.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served from. Used for magic-link redirects, Open Graph
# images and the booking links shown on the Share tab.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only, never exposed to the browser. The Paddle webhook uses this to
# write billing columns that no client-side role may touch.
# SUPABASE_SERVICE_ROLE_KEY=

# Menu scanning: Claude on Vertex AI, billed to this GCP project. Auth is the
# VM's service account (or `gcloud auth application-default login` locally).
# Leave unset to turn the scanner off. See DEPLOY.md, section 6.
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=global

# Paddle (build step 4)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_PRICE_ID=
