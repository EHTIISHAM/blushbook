# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served from. Used for magic-link redirects, Open Graph
# images and the booking links shown on the Share tab.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only, never exposed to the browser. The Paddle webhook uses this to
# write billing columns that no client-side role may touch.
# SUPABASE_SERVICE_ROLE_KEY=

# Paddle (build step 4)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_PRICE_ID=
