# Template for /opt/blushbook/.env on the VM.
#
# Copy it there, fill it in, and keep it out of git. The deploy workflow
# rewrites APP_IMAGE on every run and leaves the rest alone.

# Set by the deploy workflow. Pinned to a commit so rollbacks are exact.
APP_IMAGE=ghcr.io/<owner>/<repo>:latest

# The hostname Caddy requests a certificate for. No scheme, no trailing slash.
SITE_DOMAIN=blushbook.app

# Read by the server at runtime. These must match the values the image was
# BUILT with, because the browser bundle has those compiled in — a mismatch
# gives you a server and a client talking to two different projects.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_SITE_URL=https://blushbook.app

# Server only, never a NEXT_PUBLIC_ variable and never a Docker build arg.
# Not needed until the Paddle webhook in build step 4.
# SUPABASE_SERVICE_ROLE_KEY=
