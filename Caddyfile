# Caddy requests and renews the TLS certificate for SITE_DOMAIN by itself.
# Nothing to configure beyond the domain, and nothing installed on the host.

{$SITE_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# Next needs these to build correct absolute URLs behind a proxy.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	# Next sets its own cache headers per route; let those through untouched
	# and only add what Caddy is better placed to know.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	log {
		output stdout
		format console
	}
}
